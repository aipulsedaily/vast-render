# vast-render — example environment. COPY THIS, DO NOT EDIT IT IN PLACE.
#
#     cp .env.example .env && $EDITOR .env
#     set -a && . ./.env && set +a
#
# `.env` is gitignored. `.env.example` is tracked, via an explicit `!.env.example`
# negation, because the `.env.*` rule that protects your real file would
# otherwise hide this template too.
#
# NOTHING IN THIS FILE IS A REAL VALUE. Every placeholder is obviously fake and
# is meant to stay that way in the tracked copy.

# ---------------------------------------------------------------- credentials
# Your vast.ai API key. THIS IS A LIVE BILLING CREDENTIAL: it can rent, destroy
# and spend on your account. Get it from https://cloud.vast.ai/account/
#
# The SDK resolves the key as: explicit argument, then VAST_API_KEY, then
# ~/.config/vastai/vast_api_key, then ~/.vast_api_key. This broker never passes
# an explicit key, so the environment variable below wins over every file.
#
# If this key is ever pasted into a log, a chat, a screenshot or a commit,
# ROTATE IT IN THE CONSOLE. Deleting the file does not un-expose it.
VAST_API_KEY=replace-me-with-your-vast-ai-api-key

# SSH key the broker authenticates rented instances with. The PRIVATE key stays
# on your machine and is never uploaded anywhere by this tool; register the
# matching .pub with vast.ai. `id_*` is gitignored, so a key generated inside
# this tree will not be committed by accident — but keep it outside anyway.
VASTRENDER_SSH_KEY=/home/you/.ssh/id_vast_render

# ------------------------------------------------------------ what to render
# The assembled .blend a render job gets when it names none. This repository
# does not build scenes; assembly is an input.
VASTRENDER_SCENE=/path/to/your/scene.blend

# Colon-separated roots a job may name a scene inside. THIS IS A CONTAINMENT
# CHECK, NOT A CONVENIENCE: a client-supplied path becomes a filesystem path on
# your machine and on the rented box, so it is resolved through symlinks and
# `..` first and then required to sit inside one of these.
#
# On a fresh clone the built-in defaults do not exist, so the allowlist is empty
# apart from the broker's own scenes/ and every other path is refused. Set this.
VASTRENDER_SCENE_ROOTS=/path/to/your/projects

# Same rule, for `rq exec` bundle roots.
VASTRENDER_BUNDLE_ROOTS=/path/to/your/projects

# ------------------------------------------------------------------- the box
# Volume size requested at create, in GB.
VASTRENDER_DISK_GB=30

# Blender version installed on the instance. Should match the Blender that
# saved your scene — a scene should be rendered by the Blender that wrote it.
VASTRENDER_BLENDER_VERSION=5.2.0

# Adopt the instance on next start instead of destroying it on exit. Leaving
# this on means a rented GPU keeps billing after the broker stops.
VASTRENDER_KEEP_ON_EXIT=0

# --------------------------------------------------------------- this broker
# Port, database, output directory and log. `farm/brokers.py` overrides all of
# these per broker when you run a fleet; set them only for a single broker.
VASTRENDER_PORT=8760
VASTRENDER_DB=state/broker.db
VASTRENDER_OUT=out
VASTRENDER_LOG=state/broker.log

# Label prefix for instances this broker creates, so `vastctl` can tell its own
# rentals from anything else on the account.
VASTRENDER_LABEL=renderbroker

# Spend cap per submitted batch, in USD. `fleetctl plan` prints an estimate
# before anything is rented; this is the backstop for when the estimate is wrong.
VASTRENDER_MAX_BATCH_USD=25
